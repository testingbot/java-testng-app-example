{
  "server": "hub.testingbot.com",
  "key": "TESTINGBOT_KEY",
  "secret": "TESTINGBOT_SECRET",
  "capabilities": {
    "tb:options": {
      "build": "testng-testingbot",
      "name": "parallel_appium_test"
    },
    "appium:app": "tb://<hashed app-id>"
  },
  "environments": {
    "iPhone_16e": {
      "platformName": "iOS",
      "appium:deviceName": "iPhone 16e",
      "appium:platformVersion": "26.0",
      "appium:automationName": "XCUITest"
    },
    "iPhone_17": {
      "platformName": "iOS",
      "appium:deviceName": "iPhone 17",
      "appium:platformVersion": "26.3",
      "appium:automationName": "XCUITest"
    }
  }
}
